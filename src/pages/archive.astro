---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../config';
import { getPosts, postUrl } from '../utils/posts';

const posts = await getPosts();

const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);

const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), p]);
}
const md = (d: Date) => d.toISOString().slice(5, 10);
---
<Base title="归档">
  <main class="wrap" style="padding-top:56px;padding-bottom:80px">
    <div class="head">
      <div>
        <p class="eyebrow">02 / ARCHIVE</p>
        <h1 class="title">归档</h1>
      </div>
      <p class="mono muted" style="margin:0;font-size:13px">共 {posts.length} 篇 · 按年份倒序</p>
    </div>

    <section id="tags" class="filters" aria-labelledby="tags-h">
      <h2 id="tags-h" class="eyebrow" style="font-weight:500">TAGS / 标签</h2>
      <div class="chips" role="group" aria-label="按标签或分类筛选">
        <button type="button" class="chip" data-filter="" aria-pressed="true">全部</button>
        {CATEGORIES.map((c) => (
          <button type="button" class="chip" data-filter={`category:${c.id}`} aria-pressed="false">{c.name}</button>
        ))}
        {tags.map(([t, n]) => (
          <button type="button" class="chip" data-filter={`tag:${t}`} aria-pressed="false">#{t} <span class="muted">{n}</span></button>
        ))}
      </div>
    </section>

    {posts.length === 0 && <p class="empty" style="padding:40px 0">— 还没有文章 —</p>}

    {[...years.entries()].map(([year, list]) => (
      <section class="year" data-year>
        <div style="flex:1 1 200px">
          <h2 style="margin:0;font-size:48px;line-height:1">{year}</h2>
          <p class="mono muted" style="margin:6px 0 0;font-size:12px"><span data-count>{list.length}</span> 篇</p>
        </div>
        <div class="list">
          {list.map((p) => (
            <a class="item" href={postUrl(p)} data-category={p.data.category} data-tags={p.data.tags.join('|')}>
              <span class="mono muted" style="font-size:13px;width:56px">{md(p.data.date)}</span>
              <span class="mono accent" style="font-size:12px;width:64px">{p.no}</span>
              <span style="flex:1 1 260px;font-size:17px;font-weight:500">{p.data.title}</span>
              <span class="mono muted" style="font-size:12px">{p.data.tags.map((t) => '#' + t).join(' ')}</span>
            </a>
          ))}
          <p class="empty" data-empty hidden>— 该筛选下暂无文章 —</p>
        </div>
      </section>
    ))}

    <section aria-labelledby="cat-h" style="padding-top:48px">
      <h2 id="cat-h" class="eyebrow" style="font-weight:500;margin-bottom:16px">CATEGORIES / 分类</h2>
      <div class="cats">
        {CATEGORIES.map((c) => (
          <a href={`?category=${c.id}`} data-cat-link={c.id}>
            <span><span class="mono muted" style="font-size:12px">02 / {c.code}</span><br /><span style="font-size:20px;font-weight:700">{c.name}</span></span>
            <span class="mono accent">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.item')];
  const years = [...document.querySelectorAll<HTMLElement>('[data-year]')];

  function apply(filter: string) {
    const [kind, value] = filter ? filter.split(':') : ['', ''];
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.filter === filter));
    for (const it of items) {
      const ok =
        !kind ||
        (kind === 'tag' && (it.dataset.tags ?? '').split('|').includes(value)) ||
        (kind === 'category' && it.dataset.category === value);
      it.hidden = !ok;
    }
    for (const y of years) {
      const n = y.querySelectorAll('.item:not([hidden])').length;
      y.querySelector('[data-count]')!.textContent = String(n);
      (y.querySelector('[data-empty]') as HTMLElement).hidden = n > 0;
    }
    const url = new URL(location.href);
    url.searchParams.delete('tag');
    url.searchParams.delete('category');
    if (kind) url.searchParams.set(kind, value);
    history.replaceState(null, '', url);
  }

  for (const c of chips) c.addEventListener('click', () => apply(c.dataset.filter ?? ''));
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      apply('category:' + a.dataset.catLink);
      document.getElementById('tags')?.scrollIntoView();
    });
  }

  const q = new URLSearchParams(location.search);
  const initial = q.get('tag') ? 'tag:' + q.get('tag') : q.get('category') ? 'category:' + q.get('category') : '';
  if (initial && chips.some((c) => c.dataset.filter === initial)) apply(initial);
</script>

<style>
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; padding-bottom: 32px; border-bottom: 2px solid var(--ink); }
  .title { margin: 4px 0 0; font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: -0.01em; }
  .filters { padding: 24px 0; border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .year { display: flex; flex-wrap: wrap; gap: 16px 48px; padding: 40px 0; border-bottom: 1px solid var(--rule); }
  .list { flex: 999 1 640px; min-width: 0; border-top: 1px solid var(--ink); }
  .item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 20px; padding: 16px 8px; border-bottom: 1px solid var(--rule); }
  .item:hover { background: var(--surface); }
  .item[hidden] { display: none; }
  .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border: 1px solid var(--ink); background: var(--surface); }
  .cats a { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin: 0 -1px -1px 0; }
</style>
