---
import '../styles/global.css';
import { SITE, NAV } from '../config';
import { LANGS, LANG_META, UI, localize, stripLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 侧栏的 aria-label */
  sideLabel?: string;
  /** 首页把站名作为 h1 */
  isHome?: boolean;
  /** 本页各语言版本的地址；不传时按“同一路径换语言前缀”生成 */
  alternates?: Partial<Record<Lang, string>>;
}
const { lang, title, description = SITE.description[lang], sideLabel, isHome = false } = Astro.props;
const BrandTag = isHome ? 'h1' : 'span';
const ui = UI[lang];
const path = Astro.url.pathname;
const alternates: Partial<Record<Lang, string>> =
  Astro.props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, localize(l, stripLang(path))]));

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const home = localize(lang, '/');
const nav = NAV.map((n) => ({ ...n, href: localize(lang, n.href) }));
const fonts =
  'family=Grenze+Gotisch:wght@700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;500;600';
---
<!doctype html>
<html lang={LANG_META[lang].html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href={localize(lang, '/rss.xml')} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  {LANGS.filter((l) => alternates[l]).map((l) => (
    <link rel="alternate" hreflang={LANG_META[l].html} href={new URL(alternates[l]!, Astro.site)} />
  ))}
  {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={LANG_META[lang].og} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
</head>
<body>
  <div class="shell">
    <aside class="side" aria-label={sideLabel}>
      <slot name="side" />

      <nav class="side-block" aria-label={ui.sideNavAria}>
        <p class="side-label">MENU</p>
        {nav.map((n) => (
          <a class="menu-item" href={n.href}>
            <span class="tick" aria-hidden="true"></span>
            <span class="menu-no">{n.no}</span>
            <span class="menu-name">{n.label[lang]}</span>
            <span class="menu-sub">{n.sub}</span>
          </a>
        ))}
      </nav>

      <div class="side-foot">
        <nav class="lang-switch" aria-label={ui.langAria}>
          {LANGS.map((l) => (
            <a
              href={alternates[l] ?? localize(l, '/')}
              hreflang={LANG_META[l].html}
              lang={LANG_META[l].html}
              aria-current={l === lang ? 'page' : undefined}
            >{LANG_META[l].label}</a>
          ))}
        </nav>
        <span class="copyright">© {new Date().getFullYear()} {SITE.author} · {ui.builtWith}</span>
      </div>
    </aside>

    <div class="content">
      <header class="masthead">
        <a href={home} class="brand">
          <BrandTag class="brand-name">{SITE.name}</BrandTag>
          <span class="brand-sub">{SITE.identity[lang]}</span>
        </a>
        <nav class="topnav" aria-label={ui.navAria}>
          {nav.map((n, i) => (
            <a href={n.href} class:list={{ on: i === 0 }}>{n.label[lang]}</a>
          ))}
        </nav>
      </header>

      <slot name="strip" />

      <slot />
    </div>
  </div>
</body>
</html>
