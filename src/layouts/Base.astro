---
import '../styles/global.css';
import { SITE, NAV } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href.replace(/\/$/, ''));
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="brand">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="34" height="34" stroke="currentColor" stroke-width="2" />
          <circle cx="18" cy="18" r="8" stroke="var(--accent)" stroke-width="2" />
          <path d="M18 4v6M18 26v6M4 18h6M26 18h6" stroke="currentColor" stroke-width="2" />
        </svg>
        <span class="brand-text">
          <span class="brand-name">{SITE.name}</span>
          <span class="brand-sub">{SITE.subtitle} · SINCE {SITE.since}</span>
        </span>
      </a>
      <nav class="nav" aria-label="主导航">
        {NAV.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
            <span class="no">{n.no}</span>{n.label}<span class="en">{n.en}</span>
          </a>
        ))}
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="wrap">
      <div style="display:flex;flex-direction:column;gap:6px;max-width:520px">
        <span style="font-weight:700;letter-spacing:0.08em">{SITE.name}</span>
        <span class="muted" style="font-size:13px">本站内容仅代表作者本人当时的看法。</span>
        <span class="mono muted" style="font-size:12px">© {new Date().getFullYear()} {SITE.author} · Built with Astro · Hosted on GitHub Pages</span>
      </div>
      <nav class="fnav" aria-label="页脚导航">
        <a href="/archive/">归档 Archive</a>
        <a href="/#about">关于 About</a>
        <a href="/rss.xml">RSS</a>
        <a href="#">↑ 回到顶部</a>
      </nav>
    </div>
  </footer>
</body>
</html>
