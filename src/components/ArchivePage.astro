---
import Base from '../layouts/Base.astro';
import { UI, type Lang } from '../i18n';
import { getPosts, md, postUrl } from '../utils/posts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];

const posts = await getPosts(lang);

const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), p]);
}
---
<Base lang={lang} title={ui.archiveTitle} sideLabel={ui.archiveSideAria}>
  <div id="tags" class="side-block" role="group" aria-label={ui.filterAria} slot="side">
    <p class="side-label">TAGS</p>
    <button type="button" class="menu-item short tag-btn" data-tag="" aria-pressed="true">
      <span class="tick" aria-hidden="true"></span><span class="menu-name">{ui.all}</span><span class="menu-sub">{posts.length}</span>
    </button>
    {tags.map(([t, n]) => (
      <button type="button" class="menu-item short tag-btn" data-tag={t} aria-pressed="false">
        <span class="tick" aria-hidden="true"></span><span class="menu-name">#{t}</span><span class="menu-sub">{n}</span>
      </button>
    ))}
  </div>

  <div class="strip" slot="strip">
    <div class="strip-main" aria-live="polite">
      <span>{ui.archive}</span><span class="sep" aria-hidden="true">▶</span>
      <span class="ellipsis" data-filter-label>{ui.allTags}</span><span class="sep" aria-hidden="true">▶</span>
      <span class="count" data-total-count>{ui.postCount(posts.length)}</span>
    </div>
    <button type="button" class="strip-btn" data-reset>+ ALL</button>
  </div>

  <main class="page" style="gap:64px">
    {posts.length === 0 && (
      <section>
        <p class="sec-label">ARCHIVE</p>
        <div class="sec-head"><h1 class="h">{ui.archiveTitle}</h1></div>
        <p class="empty">{ui.noPosts}</p>
      </section>
    )}
    {[...years.entries()].map(([year, list], i) => (
      <section data-year>
        <p class="sec-label">ARCHIVE</p>
        <div class="sec-head">
          {i === 0 ? <h1 class="h">{ui.yearTitle(year)}</h1> : <h2>{ui.yearTitle(year)}</h2>}
          <span class="sec-meta" data-count>{ui.postCount(list.length)}</span>
        </div>
        {list.map((p) => (
          <a class="row" href={postUrl(p)} data-tags={p.data.tags.join('|')}>
            <time class="row-date" style="width:48px" datetime={p.data.date.toISOString()}>{md(p.data.date)}</time>
            <span class="row-title">{p.data.title}</span>
            <span class="row-tags">{p.data.tags.map((t) => '#' + t).join(' ')}</span>
          </a>
        ))}
        <p class="empty" data-empty hidden>{ui.filterEmpty}</p>
      </section>
    ))}
  </main>
</Base>

<script is:inline define:vars={{ zh: lang === 'zh', allTags: ui.allTags }}>
  const btns = [...document.querySelectorAll('.tag-btn')];
  const rows = [...document.querySelectorAll('[data-year] .row')];
  const years = [...document.querySelectorAll('[data-year]')];
  const label = document.querySelector('[data-filter-label]');
  const total = document.querySelector('[data-total-count]');
  const count = (n) => (zh ? `${n} 篇` : `${n} ${n === 1 ? 'post' : 'posts'}`);

  function apply(tag) {
    for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
    for (const r of rows) r.hidden = !!tag && !(r.dataset.tags || '').split('|').includes(tag);
    let sum = 0;
    for (const y of years) {
      const n = y.querySelectorAll('.row:not([hidden])').length;
      sum += n;
      y.querySelector('[data-count]').textContent = count(n);
      y.querySelector('[data-empty]').hidden = n > 0;
    }
    label.textContent = tag ? '#' + tag : allTags;
    total.textContent = count(sum);
    const url = new URL(location.href);
    if (tag) url.searchParams.set('tag', tag);
    else url.searchParams.delete('tag');
    history.replaceState(null, '', url);
  }

  for (const b of btns) b.addEventListener('click', () => apply(b.dataset.tag || ''));
  document.querySelector('[data-reset]').addEventListener('click', () => apply(''));

  const initial = new URLSearchParams(location.search).get('tag') || '';
  if (initial && btns.some((b) => b.dataset.tag === initial)) apply(initial);
</script>

<style>
  .h { margin: 6px 0 0; font-size: 26px; line-height: 1.2; font-weight: 400; letter-spacing: 0.04em; }
  .tag-btn[aria-pressed='false'] { color: #9e9e99; }
  .tag-btn[aria-pressed='false'] .tick { background: var(--side-rule); }
  .tag-btn:hover { opacity: 0.6; }
</style>
