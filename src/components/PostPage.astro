---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { UI, localize, type Lang } from '../i18n';
import { fmt, fmtSlash, postUrl, type Post } from '../utils/posts';

interface Props {
  lang: Lang;
  post: Post;
  newer?: Post;
  older?: Post;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, post, newer, older, alternates } = Astro.props;
const ui = UI[lang];
const L = (p: string) => localize(lang, p);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const d = post.data;
const tagUrl = (t: string) => `${L('/archive/')}?tag=${encodeURIComponent(t)}`;
---
<Base lang={lang} title={d.title} description={d.description} alternates={alternates} sideLabel={ui.postSideAria}>
  <Fragment slot="side">
    <div class="side-block" style="gap:12px">
      <p class="side-label" style="margin:0">INFO</p>
      <dl class="side-dl">
        <dt>NO.</dt><dd class="mono">{post.no}</dd>
        <dt>DATE</dt><dd class="mono"><time datetime={d.date.toISOString()}>{fmt(d.date)}</time></dd>
        {d.updated && (<><dt>UPDATED</dt><dd class="mono"><time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></dd></>)}
        <dt>READ</dt><dd>{ui.readTime(post.readMin)}</dd>
        {d.tags.length > 0 && (
          <><dt>TAGS</dt><dd class="mono tags">{d.tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}</dd></>
        )}
      </dl>
    </div>

    {toc.length > 0 && (
      <nav class="side-block toc" aria-label={ui.tocAria}>
        <p class="side-label">INDEX</p>
        {toc.map((h, i) => (
          <a class="menu-item short" href={`#${h.slug}`}>
            <span class="tick" aria-hidden="true"></span>
            <span class="menu-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="menu-name">{h.text}</span>
          </a>
        ))}
      </nav>
    )}
  </Fragment>

  <div class="strip" slot="strip">
    <nav class="strip-main" aria-label={ui.breadcrumbAria}>
      <a href={L('/#posts')}>{ui.posts}</a><span class="sep" aria-hidden="true">▶</span>
      <span class="date">{fmt(d.date)}</span><span class="sep" aria-hidden="true">▶</span>
      <span class="ellipsis">{ui.quote(d.title)}</span>
    </nav>
    <a class="strip-btn" href={L('/#posts')}>{ui.back}</a>
  </div>

  <main class="page">
    <article style="max-width:720px">
      <p class="sec-label">WRITING / NO.{post.no}</p>
      <h1 class="title">{d.title}</h1>
      {d.description ? <p class="lede">{d.description}</p> : <div class="lede" aria-hidden="true"></div>}
      {d.cover && (
        <figure class="cover">
          <img src={d.cover} alt={d.coverCaption ?? ''} />
          {d.coverCaption && <figcaption>FIG.01 — {d.coverCaption}</figcaption>}
        </figure>
      )}

      <div class="prose"><Content /></div>

      <div class="signed">
        <span>SIGNED / {SITE.name}</span><span>{SITE.license} · {fmtSlash(d.date)}</span>
      </div>

      <div class="pager">
        {older
          ? <a class="pg" href={postUrl(older)}><span class="pg-label">{ui.prev} · {older.no}</span><span>{older.data.title}</span></a>
          : <span class="pg"><span class="pg-label">{ui.prev}</span><span class="muted">{ui.firstPost}</span></span>}
        {newer
          ? <a class="pg" href={postUrl(newer)}><span class="pg-label">{newer.no} · {ui.next}</span><span>{newer.data.title}</span></a>
          : <span class="pg"><span class="pg-label">{ui.next}</span><span class="muted">{ui.latestPost}</span></span>}
      </div>
    </article>
  </main>
</Base>

<script is:inline define:vars={{ copyLabel: ui.copy, copiedLabel: ui.copied }}>
  // 代码块：加上语言名和复制按钮
  for (const pre of document.querySelectorAll('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code';
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = document.createElement('span');
    const l = pre.dataset.language;
    lang.textContent = !l || l === 'plaintext' ? 'TEXT' : l;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = copyLabel;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = copiedLabel;
        setTimeout(() => (btn.textContent = copyLabel), 1500);
      } catch {}
    });
    bar.append(lang, btn);
    pre.replaceWith(wrap);
    wrap.append(bar, pre);
  }

  // 目录高亮当前章节
  const links = [...document.querySelectorAll('.toc a')];
  if (links.length) {
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const set = (a) => links.forEach((x) => x.classList.toggle('on', x === a));
    set(links[0]);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) set(map.get(e.target.id));
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  }
</script>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .toc .tick { background: var(--side-rule); }
  .toc .menu-name { color: var(--side-dim); }
  .toc a:global(.on) .tick { background: var(--accent); }
  .toc a:global(.on) .menu-name { color: var(--side-text); }
  .title { margin: 8px 0 16px; font-size: 30px; line-height: 1.4; font-weight: 500; }
  .lede { margin: 0 0 32px; padding-bottom: 28px; border-bottom: 1px solid var(--ink); font-size: 15px; line-height: 1.9; color: var(--ink-2); }
  .cover { margin: 0 0 48px; }
  .cover img { width: 100%; border: 1px solid var(--ink); }
  .cover figcaption { margin-top: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; color: var(--muted); }
  .signed { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 56px; padding-top: 12px; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--muted); }
  .pager { display: flex; flex-wrap: wrap; margin-top: 40px; border: 1px solid var(--ink); overflow: hidden; }
  .pg { flex: 1 1 240px; display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; margin: 0 -1px -1px 0; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); font-size: 15px; background: var(--white); }
  .pg + .pg { background: var(--warm); text-align: right; }
  .pg-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: var(--muted); }
</style>
