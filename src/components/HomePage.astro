---
import Base from '../layouts/Base.astro';
import { PROFILE, GITHUB } from '../config';
import { UI, localize, type Lang } from '../i18n';
import { getPosts, fmt, fmtSlash, md, postUrl } from '../utils/posts';
import { getPullRequests } from '../utils/github';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];
const L = (p: string) => localize(lang, p);

const posts = await getPosts(lang);
const latest = posts[0];
const prs = await getPullRequests();
const MARK = { merged: '☑', open: '☐', closed: '☒' } as const;
const allPrsUrl = `https://github.com/pulls?q=${encodeURIComponent(`author:${GITHUB.user}`)}`;
---
<Base lang={lang} sideLabel={ui.profileAria} isHome>
  <Fragment slot="side">
    <div class="side-block" style="gap:12px">
      <p class="side-label" style="margin:0">PROFILE</p>
      <div class="profile">
        <div class="avatar">
          <img src={PROFILE.avatar} alt={ui.avatarAlt} width="120" height="120" loading="lazy" />
          <span class="avatar-mark" aria-hidden="true"></span>
        </div>
        <p class="bio">{PROFILE.bio[lang]}</p>
        <dl class="side-dl">
          {PROFILE.info.map((r) => (
            <>
              <dt>{r.key}</dt>
              <dd class:list={{ mono: r.mono }}>{r.href ? <a href={r.href}>{r.value[lang]}</a> : r.value[lang]}</dd>
            </>
          ))}
        </dl>
      </div>
    </div>
  </Fragment>

  <div class="strip" slot="strip">
    {latest
      ? <a class="strip-main" href={postUrl(latest)}>
          <span>{ui.latest}</span><span class="sep" aria-hidden="true">▶</span>
          <span class="date">{fmt(latest.data.date)}</span><span class="sep" aria-hidden="true">▶</span>
          <span class="ellipsis">{ui.quote(latest.data.title)}</span>
        </a>
      : <div class="strip-main"><span>{ui.latest}</span><span class="sep" aria-hidden="true">▶</span><span>{ui.firstPostSoon}</span></div>}
    <a class="strip-btn" href={L('/archive/')}>+ ALL</a>
  </div>

  <main class="page">
    <section id="posts" aria-labelledby="posts-h">
      <p class="sec-label">WRITING</p>
      <div class="sec-head">
        <h2 id="posts-h">{ui.postsTitle}</h2>
        <a class="sec-link" href={L('/archive/')}>{ui.byTag}</a>
      </div>
      {posts.length === 0 && <p class="empty">{ui.noPosts}</p>}
      {posts.slice(0, 10).map((p) => (
        <a class="row" href={postUrl(p)}>
          <time class="row-date" style="width:96px" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <span style="flex:1 1 300px;display:flex;flex-direction:column;gap:4px">
            <span style="font-size:16px;font-weight:500">{p.data.title}</span>
            {p.data.description && <span class="muted" style="font-size:13px">{p.data.description}</span>}
          </span>
          <span class="row-tags">{p.data.tags.map((t) => '#' + t).join(' ')}</span>
        </a>
      ))}
    </section>

    <section id="prs" aria-labelledby="pr-h">
      <p class="sec-label">GITHUB</p>
      <div class="sec-head" style="margin-bottom:28px">
        <h2 id="pr-h">{ui.prTitle}</h2>
        <a class="sec-link" href={allPrsUrl}>{ui.viewAll}</a>
      </div>
      <div class="frame">
        <div class="frame-inner">
          <div class="frame-bar" style="padding-bottom:12px;border-bottom:1px solid var(--ink)">
            <span>PULL REQUESTS</span><span>AUTO / 6H / {prs?.length ?? 0} OF ■</span>
          </div>
          {!prs?.length && <p class="empty">{ui.prEmpty}</p>}
          {prs?.map((pr) => (
            <a class="pr" href={pr.url}>
              <span class="mono" title={ui.prState[pr.state]} style="font-size:13px;flex:0 0 auto">
                <span aria-hidden="true">{MARK[pr.state]}</span><span class="sr-only">{ui.prState[pr.state]}</span>
              </span>
              <span class="mono muted pr-repo">{pr.repo}</span>
              <span class="pr-title">{pr.title}</span>
              <time class="mono muted" style="font-size:12px;flex:0 0 auto" datetime={pr.date.toISOString()}>{md(pr.date)}</time>
            </a>
          ))}
          <div class="frame-bar" style="margin-top:28px;padding-top:12px;border-top:1px solid var(--ink)">
            <span>GITHUB.COM/{GITHUB.user.toUpperCase()}</span><span>{fmtSlash(new Date())}</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .profile { display: flex; flex-direction: column; gap: 20px; }
  .avatar { position: relative; width: 120px; height: 120px; }
  .avatar img { width: 120px; height: 120px; object-fit: cover; border: 1px solid var(--side-text); background: #1a1a1a; }
  .avatar-mark { position: absolute; right: -5px; bottom: -5px; width: 10px; height: 10px; background: var(--accent); }
  .bio { margin: 0; font-size: 13px; line-height: 1.9; color: var(--side-dim); }
  .side-dl { margin-top: 4px; }
  .pr { display: flex; align-items: baseline; gap: 18px; padding: 12px 4px; border-bottom: 1px dashed #d2d2cc; white-space: nowrap; overflow: hidden; }
  .pr:hover { background: var(--hover); opacity: 1; }
  .pr-repo { font-size: 12px; flex: 0 0 170px; overflow: hidden; text-overflow: ellipsis; }
  .pr-title { font-size: 14px; flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 600px) { .pr-repo { flex-basis: 96px; } .pr { gap: 12px; } }
</style>
